# Copia este archivo como .env (en la misma carpeta que docker-compose.yml) y cambia los valores.
# El archivo .env NO se sube al repositorio.

# Contraseña del usuario root de MySQL (la usan MySQL y los 5 microservicios).
DB_PASSWORD=cambia-esta-clave

# Clave para firmar los JWT: mínimo 32 caracteres, la misma para todos los servicios.
# Puedes generar una con:  openssl rand -base64 48
JWT_SECRET=cambia-esta-clave-por-una-de-al-menos-32-caracteres

# Opcional: origen permitido por CORS (por ejemplo http://54.12.34.56).
# CORS_ORIGENES=http://localhost
